{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:biome",
    "biome_is": [
      "regions_unexplored:muddy_river"
    ]
  },
  "then_run": {
    "type": "regions_unexplored:config",
    "key": "custom_dirts",
    "on_disabled": {
      "type": "minecraft:block",
      "result_state": {
        "Name": "minecraft:mud"
      }
    },
    "on_enabled": {
      "type": "minecraft:block",
      "result_state": {
        "Name": "regions_unexplored:peat_mud"
      }
    }
  }
}