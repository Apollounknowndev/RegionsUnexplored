{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:biome",
    "biome_is": [
      "regions_unexplored:autumnal_maple_forest"
    ]
  },
  "then_run": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:noise_threshold",
      "max_threshold": 1.7976931348623157E308,
      "min_threshold": 0.15,
      "noise": "minecraft:surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "lithostitched:any_of",
        "conditions": [
          {
            "type": "minecraft:noise_threshold",
            "max_threshold": 1.7976931348623157E308,
            "min_threshold": 0.25,
            "noise": "regions_unexplored:shield"
          },
          {
            "type": "lithostitched:all_of",
            "conditions": [
              {
                "type": "minecraft:noise_threshold",
                "max_threshold": 1.7976931348623157E308,
                "min_threshold": 0.15,
                "noise": "regions_unexplored:shield"
              },
              {
                "type": "minecraft:noise_threshold",
                "max_threshold": 1.7976931348623157E308,
                "min_threshold": 0.0,
                "noise": "regions_unexplored:weighted"
              }
            ]
          }
        ]
      },
      "then_run": {
        "type": "regions_unexplored:config",
        "key": "custom_dirts",
        "on_disabled": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:podzol",
            "Properties": {
              "snowy": "false"
            }
          }
        },
        "on_enabled": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "regions_unexplored:silt_podzol",
            "Properties": {
              "snowy": "false"
            }
          }
        }
      }
    }
  }
}