{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:biome",
    "biome_is": [
      "regions_unexplored:redstone_caves"
    ]
  },
  "then_run": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "lithostitched:all_of",
      "conditions": [
        {
          "type": "minecraft:noise_threshold",
          "max_threshold": 1.7976931348623157E308,
          "min_threshold": 0.0,
          "noise": "minecraft:surface_swamp"
        },
        {
          "type": "minecraft:noise_threshold",
          "max_threshold": 1.7976931348623157E308,
          "min_threshold": 0.0,
          "noise": "regions_unexplored:weighted"
        }
      ]
    },
    "then_run": {
      "type": "minecraft:block",
      "result_state": {
        "Name": "regions_unexplored:raw_redstone_block"
      }
    }
  }
}