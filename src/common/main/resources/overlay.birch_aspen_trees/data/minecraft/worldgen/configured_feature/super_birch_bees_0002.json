      "lower_size": 0,
      "upper_size": 1
    },
    "trunk_placer": {
      "type": "regions_unexplored:aspen",
      "bend_chance": 0.0,
      "height": {
        "type": "minecraft:uniform",
        "max_inclusive": 12,
        "min_inclusive": 7
      }
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "minecraft:birch_log",
        "Properties": {
          "axis": "y"
        }
      }
    }
  }
