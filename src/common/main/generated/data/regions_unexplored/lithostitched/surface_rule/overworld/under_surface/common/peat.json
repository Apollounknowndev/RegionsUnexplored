{
  "type": "minecraft:condition",
  "if_true": {
    "type": "lithostitched:biome",
    "biomes": "#regions_unexplored:surface/peat"
  },
  "then_run": {
    "type": "regions_unexplored:config",
    "key": "custom_dirts",
    "on_disabled": {
      "type": "minecraft:block",
      "result_state": {
        "Name": "minecraft:dirt"
      }
    },
    "on_enabled": {
      "type": "minecraft:block",
      "result_state": {
        "Name": "regions_unexplored:peat_dirt"
      }
    }
  }
}