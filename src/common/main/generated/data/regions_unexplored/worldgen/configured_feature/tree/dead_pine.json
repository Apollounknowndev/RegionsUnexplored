{
  "type": "minecraft:tree",
  "config": {
    "below_trunk_provider": {
      "type": "minecraft:rule_based_state_provider",
      "fallback": {
        "type": "minecraft:rule_based_state_provider",
        "rules": [
          {
            "if_true": {
              "type": "minecraft:not",
              "predicate": {
                "type": "minecraft:matching_block_tag",
                "tag": "minecraft:cannot_replace_below_tree_trunk"
              }
            },
            "then": {
              "type": "minecraft:simple_state_provider",
              "state": {
                "Name": "minecraft:dirt"
              }
            }
          }
        ]
      },
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:peat/substrate"
          },
          "then": {
            "type": "regions_unexplored:key_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:silt/substrate"
          },
          "then": {
            "type": "regions_unexplored:key_hack"
          }
        }
      ]
    },
    "decorators": [
      {
        "type": "regions_unexplored:random_branch",
        "branch_block": "regions_unexplored:pine_branch",
        "leaves_provider": {
          "type": "minecraft:simple_state_provider",
          "state": {
            "Name": "regions_unexplored:pine_leaves",
            "Properties": {
              "distance": "7",
              "persistent": "false",
              "waterlogged": "false"
            }
          }
        },
        "log_block": "regions_unexplored:pine_log",
        "probability": 0.1,
        "required_empty_blocks": 3
      }
    ],
    "foliage_placer": {
      "type": "regions_unexplored:fancy_pine",
      "offset": {
        "type": "minecraft:uniform",
        "max_inclusive": 1,
        "min_inclusive": 0
      }
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:dead_pine_leaves",
        "Properties": {
          "distance": "7",
          "persistent": "false",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": false,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
