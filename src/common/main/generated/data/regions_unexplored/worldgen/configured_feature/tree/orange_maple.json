{
  "type": "minecraft:tree",
  "config": {
    "below_trunk_provider": {
      "type": "minecraft:rule_based_state_provider",
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:peat/substrate"
          },
          "then": {
            "type": "regions_unexplored:supplier_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:silt/substrate"
          },
          "then": {
            "type": "regions_unexplored:supplier_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:not",
            "predicate": {
              "type": "minecraft:matching_block_tag",
              "tag": "minecraft:cannot_replace_below_tree_trunk"
            }
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:dirt"
            }
          }
        }
      ]
    },
    "decorators": [
      {
        "type": "regions_unexplored:group_branch",
        "branch_block": "regions_unexplored:maple_branch",
        "log_block": "regions_unexplored:maple_log",
        "probability": 1.0,
        "top_offset": 3
      },
      {
        "type": "regions_unexplored:place_on_ground",
        "block_state_provider": {
          "type": "regions_unexplored:randomized_ground_cover",
          "block": "regions_unexplored:orange_maple_leaf_litter"
        },
        "height": 1,
        "radius": 3,
        "tries": 48
      }
    ],
    "foliage_placer": {
      "type": "regions_unexplored:maple"
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:orange_maple_leaves",
        "Properties": {
          "distance": "7",
          "persistent": "false",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": false,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 1,
      "lower_size": 0,
      "upper_size": 1
    },
    "trunk_placer": {
      "type": "minecraft:straight_trunk_placer",
      "base_height": 7,
      "height_rand_a": 2,
      "height_rand_b": 2
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:maple_log",
        "Properties": {
          "axis": "y"
        }
      }
    }
  }
}