{
  "type": "minecraft:tree",
  "config": {
    "below_trunk_provider": {
      "type": "minecraft:rule_based_state_provider",
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:peat/substrate"
          },
          "then": {
            "type": "regions_unexplored:supplier_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:silt/substrate"
          },
          "then": {
            "type": "regions_unexplored:supplier_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:not",
            "predicate": {
              "type": "minecraft:matching_block_tag",
              "tag": "minecraft:cannot_replace_below_tree_trunk"
            }
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:dirt"
            }
          }
        }
      ]
    },
    "decorators": [
      {
        "type": "regions_unexplored:hanging_vines",
        "block": "regions_unexplored:lavender_wisteria_vines",
        "probability": 0.4
      },
      {
        "type": "minecraft:beehive",
        "probability": 0.002
      },
      {
        "type": "regions_unexplored:random_branch",
        "branch_block": "regions_unexplored:wisteria_branch",
        "leaves_provider": {
          "type": "minecraft:simple_state_provider",
          "state": {
            "Name": "regions_unexplored:lavender_wisteria_leaves",
            "Properties": {
              "distance": "7",
              "persistent": "false",
              "waterlogged": "false"
            }
          }
        },
        "log_block": "regions_unexplored:wisteria_log",
        "probability": 0.1,
        "required_empty_blocks": 3
      }
    ],
    "foliage_placer": {
      "type": "regions_unexplored:willow",
      "hanging_leaves_chance": 0.5
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:lavender_wisteria_leaves",
        "Properties": {
          "distance": "7",
          "persistent": "false",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": true,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 1,
      "lower_size": 0,
      "upper_size": 1
    },
    "trunk_placer": {
      "type": "minecraft:fancy_trunk_placer",
      "base_height": 9,
      "height_rand_a": 9,
      "height_rand_b": 0
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:wisteria_log",
        "Properties": {
          "axis": "y"
        }
      }
    }
  }
}