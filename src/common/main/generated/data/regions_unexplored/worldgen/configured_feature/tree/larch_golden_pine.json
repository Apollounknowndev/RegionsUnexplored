{
  "type": "minecraft:tree",
  "config": {
    "below_trunk_provider": {
      "type": "minecraft:rule_based_state_provider",
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:peat/substrate"
          },
          "then": {
            "type": "regions_unexplored:key_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:silt/substrate"
          },
          "then": {
            "type": "regions_unexplored:key_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:not",
            "predicate": {
              "type": "minecraft:matching_block_tag",
              "tag": "minecraft:cannot_replace_below_tree_trunk"
            }
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:dirt"
            }
          }
        }
      ]
    },
    "decorators": [
      {
        "type": "regions_unexplored:random_branch",
        "branch_block": "regions_unexplored:larch_branch",
        "leaves_provider": {
          "type": "minecraft:simple_state_provider",
          "state": {
            "Name": "regions_unexplored:golden_larch_leaves",
            "Properties": {
              "distance": "7",
              "persistent": "false",
              "waterlogged": "false"
            }
          }
        },
        "log_block": "regions_unexplored:larch_log",
        "probability": 0.1,
        "required_empty_blocks": 3
      }
    ],
    "foliage_placer": {
      "type": "regions_unexplored:fancy_pine",
      "offset": {
        "type": "minecraft:uniform",
        "max_inclusive": 2,
        "min_inclusive": 1
      }
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:golden_larch_leaves",
        "Properties": {
          "distance": "7",
          "persistent": "false",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": true,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 2,
      "lower_size": 0,
      "upper_size": 2
    },
    "trunk_placer": {
      "type": "minecraft:straight_trunk_placer",
      "base_height": 8,
      "height_rand_a": 4,
      "height_rand_b": 2
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:larch_log",
        "Properties": {
          "axis": "y"
        }
      }
    }
  }
}