{
  "type": "minecraft:tree",
  "config": {
    "below_trunk_provider": {
      "type": "minecraft:rule_based_state_provider",
      "fallback": {
        "type": "minecraft:rule_based_state_provider",
        "rules": [
          {
            "if_true": {
              "type": "minecraft:not",
              "predicate": {
                "type": "minecraft:matching_block_tag",
                "tag": "minecraft:cannot_replace_below_tree_trunk"
              }
            },
            "then": {
              "type": "minecraft:simple_state_provider",
              "state": {
                "Name": "minecraft:dirt"
              }
            }
          }
        ]
      },
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:peat/substrate"
          },
          "then": {
            "type": "regions_unexplored:key_hack"
          }
        },
        {
          "if_true": {
            "type": "minecraft:matching_block_tag",
            "tag": "regions_unexplored:silt/substrate"
          },
          "then": {
            "type": "regions_unexplored:key_hack"
          }
        }
      ]
    },
    "decorators": [
      {
        "type": "regions_unexplored:place_on_ground",
        "block_state_provider": {
          "type": "regions_unexplored:randomized_ground_cover",
          "block": "regions_unexplored:orange_maple_leaf_litter"
        },
        "height": 1,
        "radius": 3,
        "tries": 64
      }
    ],
    "foliage_placer": {
      "type": "minecraft:fancy_foliage_placer",
      "height": 4,
      "offset": 4,
      "radius": 2
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:orange_maple_leaves",
        "Properties": {
          "distance": "7",
          "persistent": "false",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": true,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 0,
      "lower_size": 0,
      "min_clipped_height": 4,
      "upper_size": 0
    },
    "trunk_placer": {
      "type": "minecraft:fancy_trunk_placer",
      "base_height": 8,
      "height_rand_a": 11,
      "height_rand_b": 0
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "regions_unexplored:maple_log",
        "Properties": {
          "axis": "y"
        }
      }
    }
